{
  "name": "dprint-cli",
  "version": "0.4.1",
  "description": "JavaScript implementation of dprint CLI for formatter",
  "type": "module",
  "bin": {
    "dprint": "./bin/dprint"
  },
  "exports": {
    ".": "./src/index.ts",
    "./x/claude": "./src/x/claude/index.ts"
  },
  "scripts": {
    "test": "bun test ./test",
    "format": "bun run ./bin/dprint fmt",
    "check": "bun run ./bin/dprint check",
    "deploy": "bunx npm publish",
    "prepare": "./hooks/install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nounder/dprint-cli.git"
  },
  "keywords": [
    "dprint",
    "formatting"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@dprint/json": "^0.19.4",
    "@dprint/markdown": "^0.17.8",
    "@dprint/typescript": "^0.93.4",
    "@types/bun": "latest",
    "dprint": "^0.50.2",
    "tree-sitter": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.25.10"
  },
  "files": [
    "bin/",
    "src/",
    "package.json"
  ]
}
