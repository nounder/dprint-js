{
  "name": "dprint-cli",
  "version": "0.2.1",
  "description": "JavaScript implementation of dprint CLI for formatter",
  "type": "module",
  "bin": {
    "dprint": "./bin/dprint"
  },
  "scripts": {
    "test": "bun test $(find test -name '*.test.ts' -not -path 'test/comparison-extended/*')",
    "test:fast": "bun test $(find test -name '*.test.ts' -not -path 'test/comparison-extended/*')",
    "test:full": "bun test ./test",
    "format": "bun run ./bin/dprint fmt",
    "check": "bun run ./bin/dprint check",
    "publish": "bunx npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nounder/dprint-cli.git"
  },
  "keywords": [
    "dprint",
    "formatting"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dprint/formatter": "^0.4.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3",
    "dprint": "^0.50.2",
    "@dprint/typescript": "^0.93.0",
    "@dprint/json": "^0.19.3",
    "@dprint/markdown": "^0.17.8"
  }
}
