{
  "name": "dprint-js",
  "version": "0.1.0",
  "description": "JavaScript implementation of dprint CLI for code formatting",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "dprint-js": "./bin/dprint-js"
  },
  "scripts": {
    "test": "bun test ./test",
    "fmt": "bun run bin/dprint-js.js fmt",
    "check": "bun run bin/dprint-js.js check"
  },
  "keywords": [
    "dprint",
    "formatter"
  ],
  "author": "nounder",
  "license": "MIT",
  "dependencies": {
    "ignore": "^7.0.5",
    "@dprint/formatter": "^0.4.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3",
    "dprint": "^0.50.2",
    "@dprint/typescript": "^0.93.0",
    "@dprint/json": "^0.19.3",
    "@dprint/markdown": "^0.17.8"
  }
}
